{
  "name": "aquarium-manager-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "npm run codegen && tsc --noEmit",
    "pretest": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "dotenv -e .env.test -- vitest run",
    "db:migrate": "prisma migrate dev",
    "db:import-species": "tsx --env-file=.env scripts/import-species.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@prisma/client": "^6.16.0",
    "csv-parse": "^5.6.0",
    "graphql": "^16.11.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.2",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
