generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WaterType {
  FRESHWATER
  BRACKISH
  SALTWATER
}

enum Temperament {
  PEACEFUL
  SEMI_AGGRESSIVE
  AGGRESSIVE
}

enum LivestockStatus {
  HEALTHY
  SICK
  DECEASED
  SOLD
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  tanks     Tank[]
}

model Tank {
  id              String    @id @default(uuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  volumeLiters    Float
  waterType       WaterType
  hospital        Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  livestock       Livestock[]
  livestockStays  LivestockStay[]

  @@index([ownerId])
}

model Livestock {
  id              String    @id @default(uuid())
  tankId          String
  tank            Tank      @relation(fields: [tankId], references: [id], onDelete: Cascade)
  speciesId       Int
  species         Species   @relation(fields: [speciesId], references: [id])
  name            String?
  status          LivestockStatus    @default(HEALTHY)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  livestockStays  LivestockStay[]

  @@index([tankId])
}

model LivestockStay {
  id           String    @id @default(uuid())
  livestockId  String
  livestock    Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  tankId       String
  tank         Tank      @relation(fields: [tankId], references: [id], onDelete: Cascade)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tankId])
  @@index([livestockId, startDate])
}

// Shared catalog, loaded by scripts/import-species.ts. Not owned by any user.
model Species {
  id             Int         @id @default(autoincrement())
  scientificName String      @unique
  commonName     String
  waterType      WaterType
  temperament    Temperament
  minTankLiters  Int
  adultSizeCm    Float
  phMin          Float
  phMax          Float
  tempMinC       Float
  tempMaxC       Float
  livestock      Livestock[]
}
